PORT=8788
# Wajib diganti di production: openssl rand -hex 32
JWT_SECRET=change-me
DB_PATH=./data/campusos.db
# Asal request yang dibenarkan (CORS), pisahkan dengan koma. * = semua
# Production: WAJIB domain frontend sebenar (cth. https://campusos.sekolah.edu.my), bukan *
CORS_ORIGIN=*
# 1 = pulangkan token jemputan dalam respons API (untuk development; matikan di production)
EXPOSE_INVITE_TOKENS=1

# URL frontend (dipakai dalam pautan e-mel jemputan & tetapan semula kata laluan)
APP_URL=http://localhost:5174
# Penghantaran e-mel: kosongkan = hanya direkod/dilog (lihat GET /v1/dev/outbox).
# Isi dengan URL webhook (Resend/Zapier/n8n/dll.) untuk penghantaran sebenar: POST JSON {from,to,subject,text}
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_AUTH=
MAIL_FROM=CampusOS <no-reply@campusos.local>
# Secret yang dihantar penyedia pembayaran pada header Authorization: Bearer <secret>
BILLING_WEBHOOK_SECRET=

# Bilangan reverse proxy (Nginx/Caddy/Cloudflare) di hadapan API. 0 = tiada. Wajib ditetapkan betul jika di belakang proxy,
# supaya had percubaan login mengira IP sebenar pengguna, bukan IP proxy.
TRUST_PROXY=0
# Kegagalan login dibenarkan setiap akaun dalam 15 minit sebelum dikunci sementara
LOGIN_FAIL_MAX=8
# Kunci penyulitan rahsia 2FA (kosong = diterbitkan daripada JWT_SECRET)
APP_ENCRYPTION_KEY=
# 1 hanya selepas gateway pembayaran disambungkan (membuka halaman Billing + webhook)
BILLING_ENABLED=0
# Sandaran harian automatik ke folder ini (kosong = tiada); simpan N salinan terkini
BACKUP_DIR=
BACKUP_KEEP=14

# --- E-mel (jemputan guru, reset kata laluan) --- pilih SATU: SMTP (disyorkan) atau webhook. Lihat docs/EMAIL.md
# Gmail/Google Workspace: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=anda@gmail.com SMTP_PASS=<App Password 16 aksara>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0   # 1 = TLS tersirat (port 465); 0 = STARTTLS (port 587)
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusOS <anda@gmail.com>   # untuk Gmail mesti sama dengan SMTP_USER

# --- Web Push (alarm kelas walaupun app ditutup) --- `npm run vapid` menjana kunci. Kosong = dijana automatik & disimpan dalam pangkalan data.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@contoh.edu.my
# PUSH_ENABLED=0 mematikan ciri ini sepenuhnya
