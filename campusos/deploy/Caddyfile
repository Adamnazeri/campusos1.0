# HTTPS automatik (Let's Encrypt). Tetapkan DOMAIN dalam .env (mis. campusos.sekolah.edu.my) dan arahkan DNS ke pelayan.
{$DOMAIN} {
  encode zstd gzip

  header Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # API → backend; selebihnya → frontend (nginx)
  handle /v1/* {
    reverse_proxy backend:8788
  }
  handle /health {
    reverse_proxy backend:8788
  }
  handle {
    reverse_proxy web:8080
  }
}
