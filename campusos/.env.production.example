# Salin ke .env (di folder yang sama dengan docker-compose.yml). JANGAN commit fail .env.
DOMAIN=campusos.contoh.edu.my

# Wajib. Jana dengan: openssl rand -hex 32
JWT_SECRET=
# Wajib di production: kunci untuk menyulitkan rahsia 2FA dalam pangkalan data.
# Jana dengan: openssl rand -hex 32   (JANGAN tukar selepas pengguna menyediakan 2FA)
APP_ENCRYPTION_KEY=

# E-mel sebenar (jemputan guru & reset kata laluan). Pilih SMTP (disyorkan) — lihat docs/EMAIL.md
# Contoh Gmail / Google Workspace: smtp.gmail.com, port 587, SMTP_PASS = "App Password" (bukan kata laluan Gmail biasa)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CampusOS <no-reply@contoh.edu.my>
# Alternatif: webhook (kosongkan SMTP_HOST jika guna ini)
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_AUTH=

# Bil: biarkan 0 melainkan gateway pembayaran sebenar telah disambungkan
BILLING_ENABLED=0
BILLING_WEBHOOK_SECRET=

BACKUP_KEEP=14

# Web Push (alarm kelas walaupun app ditutup). Jalankan `docker compose run --rm backend npm run vapid` dan salin hasilnya.
# Dibiarkan kosong pun berfungsi (kunci dijana & disimpan dalam pangkalan data), tetapi menetapkannya di sini lebih selamat untuk pindah pelayan.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@contoh.edu.my
